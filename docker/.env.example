# Modèle de configuration pour la stack docker. Copier en `docker/.env` et
# renseigner les valeurs — ce fichier-ci ne doit JAMAIS contenir de secret.
#
#   cp docker/.env.example docker/.env
#
# `docker/.env` est ignoré par git (cf. .gitignore).

# ─── PostgreSQL (services db et backend) ─────────────────────────
POSTGRES_DB=foyer_db
POSTGRES_USER=
POSTGRES_PASSWORD=

# ─── PgAdmin ─────────────────────────────────────────────────────
# PgAdmin est publié sur pga.monsite.fr (cf. Caddyfile).
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
# Basicauth Caddy devant PgAdmin, utilisateur « security ». Valeur = hash bcrypt,
# à générer avec : docker run --rm caddy:2.7.6-alpine caddy hash-password
# ATTENTION : le service `caddy` de compose.yml ne charge pas ce fichier
# (pas de `env_file`), donc cette variable ne lui parvient pas aujourd'hui.
PGADMIN_PROXY_PASSWORD=

# ─── Sauvegardes chiffrées poussées en FTP (service db_backup) ────
FTP_SERVER=
FTP_USER=
FTP_PASSWORD=
# Passphrase de chiffrement des dumps : sans elle les backups sont illisibles.
ENCRYPTION_PASSWORD=

# ─── Backend ─────────────────────────────────────────────────────
# Signature des JWT admin. Générer avec : openssl rand -hex 32
SECRET_KEY=

# Envoi d'emails via Brevo
# MAIL_FROM doit être un expéditeur vérifié côté Brevo, sinon l'API renvoie 400.
# Une clé API inutilisée pendant 90 jours est désactivée par Brevo : le backend
# journalise alors « API Key is not enabled » à chaque tentative d'envoi.
MAIL_FROM=
BREVO_API_KEY=

# Base des liens envoyés dans les emails (reprise du formulaire), sans slash final.
PUBLIC_URL=https://inscription.monsite.fr

# Coordonnées bancaires affichées sur le récapitulatif d'adhésion
IBAN=
BIC=
BANK=

# Préfixe de code postal accepté par le formulaire (défaut : 21)
POSTAL_CODE_PREFIX=21

# Âge à partir duquel un adhérent est compté comme adulte dans les
# statistiques du tableau de bord (défaut : 16)
ADULT_AGE_THRESHOLD=16
