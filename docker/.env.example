# Modèle de configuration pour la stack docker. Copier en `docker/.env` et
# renseigner les valeurs — ce fichier-ci ne doit JAMAIS contenir de secret.
#
#   cp docker/.env.example docker/.env
#
# `docker/.env` est ignoré par git (cf. .gitignore).

# ─── PostgreSQL (services db et backend) ─────────────────────────
POSTGRES_DB=foyer_db
POSTGRES_USER=
POSTGRES_PASSWORD=

# ─── PgAdmin ─────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# ─── Sauvegardes chiffrées poussées en FTP (service db_backup) ────
FTP_SERVER=
FTP_USER=
FTP_PASSWORD=
# Passphrase de chiffrement des dumps : sans elle les backups sont illisibles.
ENCRYPTION_PASSWORD=

# ─── Backend ─────────────────────────────────────────────────────
# Signature des JWT admin. Générer avec : openssl rand -hex 32
SECRET_KEY=

# Envoi d'emails via Brevo
MAIL_FROM=
BREVO_API_KEY=

# Coordonnées bancaires affichées sur le récapitulatif d'adhésion
IBAN=
BIC=
BANK=

# Préfixe de code postal accepté par le formulaire (défaut : 21)
POSTAL_CODE_PREFIX=21
